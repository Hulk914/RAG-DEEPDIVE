# Copy this file to .env and replace these placeholders with your own values.
# .env is ignored by Git. Never put real credentials in this example file.
GOOGLE_API_KEY=replace_with_your_google_api_key
PINECONE_API_KEY=replace_with_your_pinecone_api_key

# Use a dedicated demo index: lowercase letters, numbers, and hyphens.
INDEX_NAME=rag-mini-demo

# Optional: choose another Gemini chat model available to your API account.
GEMINI_MODEL=gemini-3.5-flash-lite
